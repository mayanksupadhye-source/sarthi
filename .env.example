# SARTHI — Environment Configuration Example
# Copy to .env and fill in your values. Never commit .env to version control.

PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/sarthi

# JWT & Session Secret
JWT_SECRET=sarthi_super_secret_jwt_key_replace_in_production
SESSION_SECRET=sarthi_super_secret_session_key_replace_in_production

# Timezone
TZ=Asia/Kolkata
APP_TIMEZONE=Asia/Kolkata

# Optional: Google Calendar API credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google/callback

# Optional: Web Push (VAPID Keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sarthi.app
